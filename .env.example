NODE_ENV=development
HOST=127.0.0.1
PORT=3000

DATABASE_URL="file:./production.db"
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_DAYS=7

# SMTP для email-уведомлений о заявках
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=

# Web Push
# Сгенерировать один раз для ShumDev:
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@shumdev.ru
