generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  WAITING
  PROPOSAL
  WON
  LOST
  SPAM
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  PAUSED
  REVIEW
  LAUNCHED
  SUPPORT
  ARCHIVED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  DRAFT
  AVAILABLE
  ASSIGNED
  IN_PROGRESS
  PAUSED
  BLOCKED
  REVIEW
  DONE
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AssignmentType {
  DIRECT
  POOL
}

enum TaskVisibility {
  TEAM
  PROJECT
  PRIVATE
}

model User {
  id              Int                 @id @default(autoincrement())
  name            String
  email           String              @unique
  passwordHash    String
  role            UserRole            @default(STAFF)
  position        String?
  avatarPath      String?
  isActive        Boolean             @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  sessions        Session[]
  assignedLeads   Lead[]              @relation("LeadAssignee")
  leadNotes       LeadNote[]
  createdProjects Project[]           @relation("ProjectCreator")
  memberships     ProjectMember[]
  createdTasks    Task[]              @relation("TaskCreator")
  assignedTasks   Task[]              @relation("TaskAssignee")
  comments        TaskComment[]
  attachments     TaskAttachment[]
  checklistItems  TaskChecklistItem[] @relation("ChecklistCompleter")
  timeEntries     TimeEntry[]         @relation("TimeEntryUser")
  editedTime      TimeEntry[]         @relation("TimeEntryEditor")
  activities      Activity[]
  notifications   Notification[]

  @@index([role, isActive])
}

model Session {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @unique
  userId     Int
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Lead {
  id            Int        @id @default(autoincrement())
  name          String
  phone         String?
  email         String?
  message       String
  source        String     @default("Сайт")
  sourcePage    String?
  status        LeadStatus @default(NEW)
  assigneeId    Int?
  nextContactAt DateTime?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  assignee      User?      @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  notes         LeadNote[]
  activities    Activity[]

  @@index([status, createdAt])
  @@index([assigneeId])
}

model LeadNote {
  id        Int      @id @default(autoincrement())
  leadId    Int
  authorId  Int
  text      String
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
}

model Project {
  id            Int             @id @default(autoincrement())
  name          String
  description   String?
  status        ProjectStatus   @default(PLANNED)
  stage         String?
  priority      ProjectPriority @default(MEDIUM)
  startDate     DateTime?
  deadline      DateTime?
  siteUrl       String?
  repositoryUrl String?
  designUrl     String?
  accentColor   String?         @default("#6c4cff")
  coverPath     String?
  createdById   Int
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  createdBy     User            @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members       ProjectMember[]
  tasks         Task[]
  activities    Activity[]

  @@index([status, deadline])
}

model ProjectMember {
  id        Int      @id @default(autoincrement())
  projectId Int
  userId    Int
  joinedAt  DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Task {
  id               Int                 @id @default(autoincrement())
  code             String              @unique
  title            String
  description      String?
  expectedResult   String?
  status           TaskStatus          @default(DRAFT)
  previousStatus   TaskStatus?
  priority         TaskPriority        @default(MEDIUM)
  assignmentType   AssignmentType      @default(DIRECT)
  visibility       TaskVisibility      @default(TEAM)
  estimatedMinutes Int?
  deadline         DateTime?
  projectId        Int?
  creatorId        Int
  assigneeId       Int?
  claimedAt        DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  project          Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creator          User                @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee         User?               @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  checklist        TaskChecklistItem[]
  comments         TaskComment[]
  attachments      TaskAttachment[]
  timeEntries      TimeEntry[]
  activities       Activity[]

  @@index([status, deadline])
  @@index([assigneeId, status])
  @@index([projectId])
}

model TaskChecklistItem {
  id            Int       @id @default(autoincrement())
  taskId        Int
  text          String
  isCompleted   Boolean   @default(false)
  completedById Int?
  completedAt   DateTime?
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedBy   User?     @relation("ChecklistCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([taskId, sortOrder])
}

model TaskComment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  authorId  Int
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
}

model TaskAttachment {
  id           Int      @id @default(autoincrement())
  taskId       Int
  uploaderId   Int
  originalName String
  storedName   String?
  mimeType     String?
  sizeBytes    Int?
  externalUrl  String?
  createdAt    DateTime @default(now())
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader     User     @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
}

model TimeEntry {
  id              Int       @id @default(autoincrement())
  taskId          Int
  userId          Int
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int?
  isManual        Boolean   @default(false)
  note            String?
  editedById      Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user            User      @relation("TimeEntryUser", fields: [userId], references: [id], onDelete: Cascade)
  editedBy        User?     @relation("TimeEntryEditor", fields: [editedById], references: [id], onDelete: SetNull)

  @@index([userId, endedAt])
  @@index([taskId, startedAt])
}

model Activity {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  type       String
  entityType String
  entityId   Int?
  title      String
  details    Json?
  projectId  Int?
  taskId     Int?
  leadId     Int?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([projectId])
  @@index([type])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  title     String
  message   String?
  href      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}
